# Copy this file to `.env` in the same folder (`travel-engine/backend/`).
# Never commit `.env`.

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
# No wrapping quotes — paste raw key after = . Restart uvicorn after editing.
GEMINI_API_KEY=
# If you get model errors try: gemini-2.5-flash, gemini-2.5-flash-lite, or gemini-1.5-flash-latest
GEMINI_MODEL=gemini-3-flash-preview

# CORS — comma-separated; add production origins when deploying
CORS_ORIGINS=http://localhost:4200

# Database (default: SQLite relative to cwd when you run uvicorn)
DATABASE_URL=sqlite+aiosqlite:///./traveldb.sqlite

# Planner: true skips Vertex unless GEMINI_API_KEY is set (app uses Gemini API first when key exists)
USE_MOCK_GOOGLE=true

# GCP project id — only matters for Vertex when USE_MOCK_GOOGLE=false
GOOGLE_CLOUD_PROJECT=test-project

# SQL logging
SQLALCHEMY_ECHO=false
